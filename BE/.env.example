# Salin ke .env (jangan commit .env asli — lihat RULES.md 2.5)
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# --- Mini-Router: rantai provider (diprioritaskan dari atas) ---
# Format OpenAI-compatible. Tambah provider tanpa coding via ROUTER_CONFIG_JSON.
# Contoh 90 RPM efektif: OpenRouter 15 + Groq 25 + Gemini 50
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_RPM=15
# Auto-fetch model GRATIS (free-only): TTL jam + urutan preferensi
OPENROUTER_MODELS_TTL_H=12
OPENROUTER_MODEL_PREFER=auto,nemotron,nvidia,qwen,llama,glm
# Token untuk POST /api/v1/admin/models/refresh (kosong = nonaktif)
ADMIN_TOKEN=
APP_URL=http://localhost:3000
APP_TITLE=JHIC2.0 CS Chatbot Prototype

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_RPM=25

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_RPM=50

# Jika semua LLM mati (tanpa key / offline), balas dari template lokal agar /test tetap bisa didemo
OFFLINE_FALLBACK=true

# --- Retrieval ---
RETRIEVAL_TOP_K=3
RETRIEVAL_THRESHOLD=0.35

# --- Rate limit (sesuai kesepakatan: 15/menit/user) ---
RATE_USER_PER_MIN=15
RATE_GLOBAL_PER_MIN=300
RATE_USER_PER_HOUR=100
